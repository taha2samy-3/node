ARG BASE_IMAGE=cgr.dev/chainguard/wolfi-base:latest
ARG GO_VERSION=1.23

# ==========================================
# envoke (secrets-entrypoint) binary
# ==========================================
FROM ${BASE_IMAGE} AS envoke

ARG TARGETARCH
ARG ENVOKE_VERSION
ARG ENVOKE_SHA256_AMD64
ARG ENVOKE_SHA256_ARM64

ADD https://github.com/taha2samy-3/envoke/releases/download/${ENVOKE_VERSION}/secrets-entrypoint_linux_${TARGETARCH} /out/secrets-entrypoint

RUN set -e; \
    case "${TARGETARCH}" in \
      amd64) sum="${ENVOKE_SHA256_AMD64}" ;; \
      arm64) sum="${ENVOKE_SHA256_ARM64}" ;; \
      *) echo "envoke: unsupported architecture ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    if [ -z "${sum}" ]; then echo "envoke: missing checksum for ${TARGETARCH}" >&2; exit 1; fi; \
    echo "${sum}  /out/secrets-entrypoint" | sha256sum -c -; \
    chmod 0755 /out/secrets-entrypoint; \
    ln -s secrets-entrypoint /out/envoke

# ==========================================
# Stage 1: Development Image (full-dev)
# ==========================================
FROM ${BASE_IMAGE} AS full-dev

ARG GO_VERSION
ARG GO_FULL_VERSION

USER root

RUN apk update && apk add --no-cache \
    go-${GO_VERSION}${GO_FULL_VERSION:+=$GO_FULL_VERSION} \
    build-base \
    git \
    tini

COPY --from=envoke /out/ /usr/bin/

RUN adduser -D -u 1000 go && \
    mkdir /app && chown go:go /app

WORKDIR /app
USER go
ENV GOPATH=/app/go
ENV PATH=$PATH:/app/go/bin

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD ["go", "version"]

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["go", "version"]


# ==========================================
# Stage 2: Minimal Production Prep
# ==========================================
FROM ${BASE_IMAGE} AS minimal-prep

ARG GO_VERSION

USER root

RUN apk update && apk add --no-cache \
    ca-certificates \
    tzdata \
    tini

COPY --from=envoke /out/ /usr/bin/

RUN adduser -D -u 1000 go && \
    mkdir /app && chown go:go /app

# ==========================================
# Stage 3: Minimal Cleaner
# ==========================================
FROM minimal-prep AS minimal-cleaner

RUN rm -rf \
    /lib/apk/db \
    /var/cache/apk \
    /etc/apk \
    /usr/share/apk \
    /usr/share/man \
    /usr/share/doc \
    /tmp/*

# ==========================================
# Stage 4: Final Production Image (minimal)
# ==========================================
FROM scratch AS minimal

COPY --from=minimal-cleaner / /

# wolfi-base sets SSL_CERT_FILE, but FROM scratch drops it (STIG SV-263659)
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
WORKDIR /app
USER go

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD ["/bin/sh", "-c", "exit 0"]

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/bin/sh"]

# ==========================================
# Stage 5: Go FIPS Development (fips-dev)
# Builds fips-check binary with BoringCrypto and runs it to verify the toolchain.
# ==========================================
FROM full-dev AS fips-dev

COPY go/fips/fips-check.go /usr/share/go-fips/fips-check.go

ENV CGO_ENABLED=1 \
    GOEXPERIMENT=boringcrypto

USER root
# Build a self-contained binary then immediately execute it — build fails if BoringCrypto is absent
RUN CGO_ENABLED=1 GOEXPERIMENT=boringcrypto \
      go build -o /usr/share/go-fips/fips-check /usr/share/go-fips/fips-check.go && \
    /usr/share/go-fips/fips-check && \
    go clean -cache && rm -rf /root/.cache/go-build
USER go

# ==========================================
# Stage 6: Go FIPS Production (fips-prod)
# Copies the pre-verified binary and re-executes it in the production rootfs.
# ==========================================
FROM minimal AS fips-prod

COPY --from=fips-dev /usr/share/go-fips/fips-check /usr/share/go-fips/fips-check

# Re-run the check inside the production image to confirm the runtime environment
RUN ["/usr/share/go-fips/fips-check"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD ["/usr/share/go-fips/fips-check"]
