        {
          "created": "2026-10-28T09:08:19.49258541Z",
          "created_by": "RUN |2 PYTHON_VERSION=3.10 PYTHON_FULL_VERSION=3.10.22-r5 /bin/sh -c apk update \u0026\u0026 apk add --no-cache     python-${PYTHON_VERSION}=${PYTHON_FULL_VERSION}     py${PYTHON_VERSION}-pip     build-base     tini # buildkit",
          "comment": "buildkit.dockerfile.v0"
        },
        {
          "created": "2026-10-28T09:08:19.551850035Z",
          "created_by": "COPY /out/ /usr/bin/ # buildkit",
          "comment": "buildkit.dockerfile.v0"
        },
        {
          "created": "2026-10-28T09:08:19.597672648Z",
          "created_by": "RUN |2 PYTHON_VERSION=3.10 PYTHON_FULL_VERSION=3.10.22-r5 /bin/sh -c adduser -D -u 1000 python \u0026\u0026     mkdir /app \u0026\u0026 chown python:python /app \u0026\u0026     ln -sf /usr/bin/python${PYTHON_VERSION} /usr/bin/python \u0026\u0026     ln -sf /usr/bin/pip${PYTHON_VERSION} /usr/bin/pip # buildkit",
          "comment": "buildkit.dockerfile.v0"
        },
        {
          "created": "2026-10-28T09:08:19.606538635Z",
          "created_by": "WORKDIR /app",
          "comment": "buildkit.dockerfile.v0"
