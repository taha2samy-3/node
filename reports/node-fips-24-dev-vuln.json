        {
          "created": "2026-10-27T06:35:11.640998795Z",
          "created_by": "RUN |2 NODE_VERSION=24 NODE_FULL_VERSION=24.22.1-r2 /bin/sh -c apk update \u0026\u0026 apk add --no-cache     nodejs-${NODE_VERSION}=${NODE_FULL_VERSION}     npm # buildkit",
