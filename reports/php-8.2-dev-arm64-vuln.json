          "created_by": "COPY /out/composer /usr/bin/composer # buildkit",
          "comment": "buildkit.dockerfile.v0"
        },
        {
          "created": "2026-10-28T12:18:17.702215933Z",
          "created_by": "COPY php/conf/php-hardened.ini /etc/php/conf.d/90-hardened.ini # buildkit",
          "comment": "buildkit.dockerfile.v0"
        },
        {
          "created": "2026-10-28T12:18:17.71360461Z",
          "created_by": "COPY php/conf/php-8.5.ini /tmp/php-8.5.ini # buildkit",
          "comment": "buildkit.dockerfile.v0"
        },
        {
          "created": "2026-10-28T12:18:17.84950692Z",
          "created_by": "RUN |3 PHP_VERSION=8.2 PHP_FULL_VERSION=8.2.35-r0 PHP_EXTENSIONS=bcmath ctype curl dom fileinfo gd iconv intl mbstring mysqlnd openssl pdo pdo_mysql pdo_pgsql pdo_sqlite phar simplexml sodium sockets xml xmlreader xmlwriter zip /bin/sh -c set -eux;     case \"${PHP_VERSION}\" in 8.5) mv /tmp/php-8.5.ini /etc/php/conf.d/91-php-8.5.ini ;; *) rm /tmp/php-8.5.ini ;; esac;     adduser -D -u 1000 php;     mkdir /app \u0026\u0026 chown php:php /app;     test \"$(php -r 'echo (int) ini_get(\"session.upload_progress.enabled\");')\" = 0;     test \"$(php -r 'echo ini_get(\"expose_php\") ? 1 : 0;')\" = 0;     composer --version # buildkit",
          "comment": "buildkit.dockerfile.v0"
        },
        {
          "created": "2026-10-28T12:18:17.865177809Z",
          "created_by": "WORKDIR /app",
          "comment": "buildkit.dockerfile.v0"
        },
