          "Layer": {
            "Digest": "sha256:0a5499871060416b5ed9a7859e00d0dd316f9cb412107d171dac7512f70217b8",
            "DiffID": "sha256:74f108835c3ffb58fbc2e02c94231e42a6c531bc6f11536ffb9cb4f4a760f55d"
          },
          "PrimaryURL": "https://avd.aquasec.com/nvd/cve-2026-106069",
          "DataSource": {
            "ID": "wolfi",
            "Name": "Wolfi Secdb",
            "URL": "https://packages.wolfi.dev/os/security.json"
          },
          "Title": "nodejs: nodejs: TLS certificate hostname bypass via non-canonical IP hostnames",
          "Description": "A flaw in Node.js TLS hostname verification can cause a server certificate to be validated against a different IP address than the one the client connected to, when the host is a non-canonical IPv4 literal with a leading zero, such as `0127.0.0.1`.\n\n`tls.checkServerIdentity()` normalizes the host following the WHATWG URL rules, which read a leading-zero octet as octal (`0127.0.0.1` becomes `87.0.0.1`), while the connection is made through the operating system resolver, which on some platforms such as macOS reads it as decimal (`127.0.0.1`). A server at the connected address can then be authenticated with a certificate issued for another IP address.\n\nThis vulnerability affects Node.js **26.x**, **24.x**, and **22.x**.",
          "Severity": "HIGH",
          "CweIDs": [
            "CWE-295"
          ],
          "VendorSeverity": {
            "amazon": 3,
            "redhat": 3
          },
