        {
          "created": "2026-10-28T12:18:06.155911611Z",
          "created_by": "RUN |3 PHP_VERSION=8.3 PHP_FULL_VERSION=8.3.36-r0 PHP_EXTENSIONS=bcmath ctype curl dom fileinfo gd iconv intl mbstring mysqlnd openssl pdo pdo_mysql pdo_pgsql pdo_sqlite phar simplexml sodium sockets xml xmlreader xmlwriter zip /bin/sh -c set -eux;     test -n \"${PHP_FULL_VERSION}\";     exts=\"${PHP_EXTENSIONS}\";     case \"${PHP_VERSION}\" in 8.5) ;; *) exts=\"${exts} opcache\" ;; esac;     pkgs=\"php-${PHP_VERSION}=${PHP_FULL_VERSION} php-${PHP_VERSION}-fpm=${PHP_FULL_VERSION}\";     for e in ${exts}; do pkgs=\"${pkgs} php-${PHP_VERSION}-${e}=${PHP_FULL_VERSION}\"; done;     apk add --no-cache ${pkgs} build-base git unzip tini;     php -v; php -m;     test -z \"$(php -r '' 2\u003e\u00261)\" # buildkit",
          "comment": "buildkit.dockerfile.v0"
        },
        {
          "created": "2026-10-28T12:18:06.202897847Z",
          "created_by": "COPY /out/ /usr/bin/ # buildkit",
          "comment": "buildkit.dockerfile.v0"
        },
        {
          "created": "2026-10-28T12:18:06.22263203Z",
