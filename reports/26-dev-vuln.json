          "created": "2026-10-28T09:08:09.805658336Z",
          "created_by": "RUN |2 NODE_VERSION=26 NODE_FULL_VERSION=26.12.1-r2 /bin/sh -c apk update \u0026\u0026 apk add --no-cache     nodejs-${NODE_VERSION}=${NODE_FULL_VERSION}     npm # buildkit",
