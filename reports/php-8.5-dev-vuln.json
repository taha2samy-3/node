        {
          "created": "2026-11-20T02:13:05.805386683Z",
          "created_by": "RUN |3 PHP_VERSION=8.5 PHP_FULL_VERSION=8.5.13-r1 PHP_EXTENSIONS=bcmath ctype curl dom fileinfo gd iconv intl mbstring mysqlnd openssl pdo pdo_mysql pdo_pgsql pdo_sqlite phar simplexml sodium sockets xml xmlreader xmlwriter zip /bin/sh -c set -eux;     test -n \"${PHP_FULL_VERSION}\";     exts=\"${PHP_EXTENSIONS}\";     case \"${PHP_VERSION}\" in 8.5) ;; *) exts=\"${exts} opcache\" ;; esac;     pkgs=\"php-${PHP_VERSION}=${PHP_FULL_VERSION} php-${PHP_VERSION}-fpm=${PHP_FULL_VERSION}\";     for e in ${exts}; do pkgs=\"${pkgs} php-${PHP_VERSION}-${e}=${PHP_FULL_VERSION}\"; done;     apk add --no-cache ${pkgs} build-base git unzip tini;     php -v; php -m;     test -z \"$(php -r '' 2\u003e\u00261)\" # buildkit",
