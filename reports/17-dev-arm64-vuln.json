          "created": "2026-10-28T09:42:35.636514375Z",
          "created_by": "ARG JAVA_VERSION=17",
          "comment": "buildkit.dockerfile.v0",
          "empty_layer": true
        },
        {
          "created": "2026-10-28T09:42:35.636514375Z",
          "created_by": "ARG JAVA_FULL_VERSION=17.0.21.0.3-r0",
          "comment": "buildkit.dockerfile.v0",
          "empty_layer": true
        },
        {
          "created": "2026-10-28T09:42:35.636514375Z",
          "created_by": "USER root",
          "comment": "buildkit.dockerfile.v0",
          "empty_layer": true
        },
        {
          "created": "2026-10-28T09:42:35.636514375Z",
          "created_by": "RUN |2 JAVA_VERSION=17 JAVA_FULL_VERSION=17.0.21.0.3-r0 /bin/sh -c apk update \u0026\u0026 apk add --no-cache     openjdk-${JAVA_VERSION}-default-jdk=${JAVA_FULL_VERSION}     tini # buildkit",
          "comment": "buildkit.dockerfile.v0"
        },
        {
          "created": "2026-10-28T09:42:35.70936941Z",
          "created_by": "RUN |2 JAVA_VERSION=17 JAVA_FULL_VERSION=17.0.21.0.3-r0 /bin/sh -c if [ -f /etc/ssl/certs/java/cacerts ]; then (cd /etc/ssl/certs/java \u0026\u0026 sha256sum cacerts \u003e .cacerts.sha256 \u0026\u0026 chmod 444 .cacerts.sha256); fi # buildkit",
          "comment": "buildkit.dockerfile.v0"
        },
        {
          "created": "2026-10-28T09:42:35.776536057Z",
          "created_by": "COPY /out/ /usr/bin/ # buildkit",
          "comment": "buildkit.dockerfile.v0"
        },
        {
          "created": "2026-10-28T09:42:35.871073031Z",
          "created_by": "RUN |2 JAVA_VERSION=17 JAVA_FULL_VERSION=17.0.21.0.3-r0 /bin/sh -c adduser -D -u 1000 java \u0026\u0026     mkdir /app \u0026\u0026 chown java:java /app # buildkit",
          "comment": "buildkit.dockerfile.v0"
        },
        {
          "created": "2026-10-28T09:42:35.894752237Z",
          "created_by": "WORKDIR /app",
          "comment": "buildkit.dockerfile.v0"
        },
        {
          "created": "2026-10-28T09:42:35.894752237Z",
          "created_by": "USER java",
          "comment": "buildkit.dockerfile.v0",
          "empty_layer": true
        },
