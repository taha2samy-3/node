        {
          "created": "2026-10-27T03:57:12.044093445Z",
          "created_by": "RUN |2 PYTHON_VERSION=3.11 PYTHON_FULL_VERSION=3.11.17-r3 /bin/sh -c apk update \u0026\u0026 apk add --no-cache     python-${PYTHON_VERSION}=${PYTHON_FULL_VERSION}     py${PYTHON_VERSION}-pip     build-base     tini # buildkit",
          "comment": "buildkit.dockerfile.v0"
        },
        {
          "created": "2026-10-27T03:57:12.099009845Z",
          "created_by": "COPY /out/ /usr/bin/ # buildkit",
          "comment": "buildkit.dockerfile.v0"
        },
        {
          "created": "2026-10-27T03:57:12.145696607Z",
          "created_by": "RUN |2 PYTHON_VERSION=3.11 PYTHON_FULL_VERSION=3.11.17-r3 /bin/sh -c adduser -D -u 1000 python \u0026\u0026     mkdir /app \u0026\u0026 chown python:python /app \u0026\u0026     ln -sf /usr/bin/python${PYTHON_VERSION} /usr/bin/python \u0026\u0026     ln -sf /usr/bin/pip${PYTHON_VERSION} /usr/bin/pip # buildkit",
          "comment": "buildkit.dockerfile.v0"
        },
        {
          "created": "2026-10-27T03:57:12.153441103Z",
          "created_by": "WORKDIR /app",
          "comment": "buildkit.dockerfile.v0"
        },
