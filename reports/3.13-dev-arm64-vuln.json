        {
          "created": "2026-10-27T06:36:40.760566792Z",
          "created_by": "RUN |2 PYTHON_VERSION=3.13 PYTHON_FULL_VERSION=3.13.16_git20261016-r2 /bin/sh -c adduser -D -u 1000 python \u0026\u0026     mkdir /app \u0026\u0026 chown python:python /app \u0026\u0026     ln -sf /usr/bin/python${PYTHON_VERSION} /usr/bin/python \u0026\u0026     ln -sf /usr/bin/pip${PYTHON_VERSION} /usr/bin/pip # buildkit",
