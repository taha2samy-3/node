          "created": "2026-10-27T06:36:40.659100172Z",
          "created_by": "RUN |2 PYTHON_VERSION=3.13 PYTHON_FULL_VERSION=3.13.16_git20261016-r2 /bin/sh -c apk update \u0026\u0026 apk add --no-cache     python-${PYTHON_VERSION}=${PYTHON_FULL_VERSION}     py${PYTHON_VERSION}-pip     build-base     tini # buildkit",
