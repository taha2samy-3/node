# OpenSSL configuration for the Node.js FIPS images.
#
# Node.js reads the nodejs_conf section and every other OpenSSL consumer reads
# openssl_conf; both activate the validated FIPS provider and make fips=yes the
# default property, so non-approved algorithms (MD5, ChaCha20, RSA < 2048, ...)
# are rejected. The base provider only supplies encoders/decoders (PEM, DER).
config_diagnostics = 1
openssl_conf = openssl_init
nodejs_conf = openssl_init

# Generated by `openssl fipsinstall` for the exact fips.so shipped in the image
.include /etc/ssl/fips/fipsmodule.cnf

[openssl_init]
providers = provider_sect
alg_section = algorithm_sect

[provider_sect]
fips = fips_sect
base = base_sect

[base_sect]
activate = 1

[algorithm_sect]
default_properties = fips=yes
