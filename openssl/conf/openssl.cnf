config_diagnostics = 1
openssl_conf = openssl_init

.pragma includedir:/etc/ssl
# [fips_sect] must NOT be defined here — it is generated exclusively by
# `openssl fipsinstall` and loaded via the .include below.
.include fipsmodule.cnf

[openssl_init]
providers = provider_sect
alg_section = algorithm_sect

[algorithm_sect]
default_properties = fips=yes

[provider_sect]
fips = fips_sect
base = base_sect

[base_sect]
activate = 1